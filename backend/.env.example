NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Use um banco e usuário exclusivos para a aplicação. Codifique caracteres
# especiais da senha na URL (por exemplo, @ torna-se %40).
DATABASE_URL=postgresql://horta:SUA_SENHA@127.0.0.1:5432/horta_inteligente
DATABASE_SSL=false

# npm run setup:env gera uma chave aleatória de 64 bytes no arquivo .env.
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
JWT_ISSUER=horta-inteligente-api
JWT_AUDIENCE=horta-inteligente-web
BCRYPT_ROUNDS=12

# Origens do frontend separadas por vírgula; vazio desabilita CORS entre origens.
CORS_ORIGINS=
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Fotos são privadas; caminhos relativos são resolvidos na raiz deste projeto.
UPLOAD_DIR=storage/uploads
# Opcional para iniciar a API; obrigatória apenas ao solicitar identificação.
PLANTNET_API_KEY=
PLANTNET_PROJECT=all
PLANTNET_TIMEOUT_MS=20000

# MQTT: false mantém a API funcionando sem broker.
MQTT_ENABLED=false
MQTT_TEST_MODE=true
MQTT_URL=mqtt://test.mosquitto.org:1883
MQTT_PREFIX=senai/mateu-horta-7c91
MQTT_USERNAME=
MQTT_PASSWORD=
# Vazio gera identificador único por processo.
MQTT_CLIENT_ID=
